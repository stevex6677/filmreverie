{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gallery-api-local",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "PRIVATE_BUCKET",
      "bucket_name": "gallery-private"
    },
    {
      "binding": "PUBLIC_BUCKET",
      "bucket_name": "gallery-public"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://example.com",
    "DEV_LOGIN_ORIGINS": "http://localhost:5180,http://127.0.0.1:5180",
    "PHOTO_ORIGIN": "https://photos.example.com",
    "ACCESS_ISSUER": "https://your-team.cloudflareaccess.com",
    "R2_ACCOUNT_ID": "00000000000000000000000000000000",
    "PRIVATE_BUCKET_NAME": "gallery-private"
  },
  "observability": {
    "enabled": false
  }
}
